// ════════════════════════════════════════════════════════════════════════════
// Julius Trading Platform — RSI + Bollinger Bands Strategy
// Pine Script v5  |  Apply to any chart in TradingView
//
// Exact replication of the Python backtest logic:
//   BUY  when RSI(14) < 30  AND  Close ≤ Lower BB(20, 2σ)
//   SELL when RSI(14) > 70  AND  Close ≥ Upper BB(20, 2σ)
//   SELL takes priority if both conditions fire simultaneously
//
// Math matches the Python implementation:
//   RSI  → Wilder's smoothing (ewm alpha=1/period) = ta.rsi() in Pine
//   BB   → SMA ± n*stdev(ddof=1)                  = ta.bb()  in Pine
// ════════════════════════════════════════════════════════════════════════════

//@version=5
strategy(
     title             = "Julius | RSI + Bollinger Bands",
     shorttitle        = "Julius RSI+BB",
     overlay           = true,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.1,
     slippage          = 1,
     calc_on_every_tick = false
)

// ── Inputs ───────────────────────────────────────────────────────────────────
grpRSI = "RSI Settings"
rsiPeriod     = input.int  (14,   "RSI Period",         minval=2,   maxval=50,  group=grpRSI)
rsiOversold   = input.float(30.0, "Oversold Level",     minval=5,   maxval=49,  step=1, group=grpRSI)
rsiOverbought = input.float(70.0, "Overbought Level",   minval=51,  maxval=95,  step=1, group=grpRSI)

grpBB = "Bollinger Band Settings"
bbPeriod = input.int  (20,  "BB Period",    minval=5,  maxval=200, group=grpBB)
bbStdDev = input.float(2.0, "BB Std Dev",   minval=0.5, maxval=4.0, step=0.1, group=grpBB)

grpVis = "Display"
showBB      = input.bool(true,  "Show Bollinger Bands", group=grpVis)
showSignals = input.bool(true,  "Show BUY / SELL Labels", group=grpVis)
showTable   = input.bool(true,  "Show Parameter Table",   group=grpVis)

// ── Indicators ────────────────────────────────────────────────────────────────
rsi = ta.rsi(close, rsiPeriod)

[bbMid, bbUpper, bbLower] = ta.bb(close, bbPeriod, bbStdDev)

// ── Signal logic (mirrors Python exactly) ────────────────────────────────────
buyCond  = rsi < rsiOversold  and close <= bbLower
sellCond = rsi > rsiOverbought and close >= bbUpper

// SELL has priority — matches: signals[sell_cond] = -1 overrides buy
longSignal  = buyCond  and not sellCond
shortSignal = sellCond

// ── Strategy orders ───────────────────────────────────────────────────────────
if shortSignal
    strategy.close("Long", comment="SELL — RSI OB + BB Upper")

if longSignal
    strategy.entry("Long", strategy.long, comment="BUY — RSI OS + BB Lower")

// ── Bollinger Band plots ──────────────────────────────────────────────────────
pUpper = plot(showBB ? bbUpper : na, "BB Upper",  color=color.new(color.blue, 60), linewidth=1)
pMid   = plot(showBB ? bbMid   : na, "BB Middle", color=color.new(color.blue, 75), linewidth=1, style=plot.style_line)
pLower = plot(showBB ? bbLower : na, "BB Lower",  color=color.new(color.blue, 60), linewidth=1)

fill(pUpper, pLower, color=color.new(color.blue, 90), title="BB Fill")

// ── Signal markers ────────────────────────────────────────────────────────────
plotshape(
     showSignals and longSignal,
     title     = "BUY Signal",
     style     = shape.labelup,
     location  = location.belowbar,
     color     = color.new(color.green, 0),
     textcolor = color.white,
     text      = "B",
     size      = size.small
)

plotshape(
     showSignals and shortSignal,
     title     = "SELL Signal",
     style     = shape.labeldown,
     location  = location.abovebar,
     color     = color.new(color.red, 0),
     textcolor = color.white,
     text      = "S",
     size      = size.small
)

// Close price color — green when in position
barcolor(strategy.position_size > 0 ? color.new(color.green, 70) : na)

// ── RSI pane (add separately if you want it visible) ─────────────────────────
// Uncomment the block below OR add the built-in RSI indicator in TradingView
//
// rsiPanel  = plot(rsi, "RSI", color=color.purple, display=display.pane)
// hline(rsiOversold,   "Oversold",   color=color.green, linestyle=hline.style_dashed)
// hline(rsiOverbought, "Overbought", color=color.red,   linestyle=hline.style_dashed)
// hline(50,            "Mid",        color=color.gray,  linestyle=hline.style_dotted)

// ── Parameter table ───────────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 7,
     bgcolor      = color.new(color.white, 85),
     border_color = color.new(color.gray, 60),
     border_width = 1,
     frame_color  = color.new(color.gray, 40),
     frame_width  = 1
)

if barstate.islast and showTable
    table.cell(tbl, 0, 0, "Julius Platform",   text_color=color.new(color.blue, 20),  text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 0, "RSI + BB Strategy", text_color=color.new(color.blue, 20),  text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 0, 1, "RSI Period",   text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(rsiPeriod), text_size=size.small)
    table.cell(tbl, 0, 2, "Oversold",     text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(rsiOversold), text_size=size.small)
    table.cell(tbl, 0, 3, "Overbought",   text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(rsiOverbought), text_size=size.small)
    table.cell(tbl, 0, 4, "BB Period",    text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(bbPeriod), text_size=size.small)
    table.cell(tbl, 0, 5, "BB Std Dev",   text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(bbStdDev), text_size=size.small)
    table.cell(tbl, 0, 6, "Commission",   text_size=size.small)
    table.cell(tbl, 1, 6, "0.1%",         text_size=size.small)
